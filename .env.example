# 관리자 페이지 설정 — 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 관리자 비밀번호 (8자 이상)
ADMIN_PASSWORD=
# 쿠키 서명용 비밀 키 (16자 이상 무작위 문자열, 비워 두면 비밀번호에서 자동으로 만듭니다)
ADMIN_SESSION_SECRET=
# 로컬 개발 서버 포트
PORT=8796
# 토스페이먼츠 결제위젯 키 (테스트: test_gck_ / test_gsk_ 로 시작)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 카카오 로그인 (developers.kakao.com → 플랫폼 키 → REST API 키 / 클라이언트 시크릿)
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
# 배포용 저장소 Upstash Redis (비워 두면 로컬 data/ 폴더의 JSON 파일에 저장)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
